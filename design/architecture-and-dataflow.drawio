  <!-- DIAGRAM 2: DATA FLOW & HOT INDEX LIFECYCLE                                -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <diagram id="dataflow-lifecycle" name="2. Data Flow &amp; Hot Index Lifecycle">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="df-title" value="Clinical Notes Aggregator — Multi-Tenant Ingestion, Hot Indexing, Lazy S3 Rehydration &amp; Eviction Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- FLOW 1: SYNCHRONOUS INGESTION -->
        <mxCell id="box-flow1" value="FLOW 1: Synchronous Ingestion &amp;amp; Dual Write (POST /api/v1/notes)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;fontStyle=1;fontSize=13;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1720" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f1-step1" value="&lt;b&gt;1. EMR Client POSTs Note&lt;/b&gt;&lt;br/&gt;Payload: JSON note or array&lt;br/&gt;Header: &lt;code&gt;X-Tenant-Id: TMH-MUMBAI&lt;/code&gt;&lt;br/&gt;Header: &lt;code&gt;Idempotency-Key: ...&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=11;" vertex="1" parent="box-flow1">
          <mxGeometry x="30" y="50" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1-step2" value="&lt;b&gt;2. API Gateway &amp;amp; Lambda&lt;/b&gt;&lt;br/&gt;&lt;code&gt;notes-ingestion-handler&lt;/code&gt;&lt;br/&gt;Checks DynamoDB Idempotency&lt;br/&gt;Prevents duplicate record creation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontSize=11;" vertex="1" parent="box-flow1">
          <mxGeometry x="300" y="50" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1-step3" value="&lt;b&gt;3. Inline PHI Masking&lt;/b&gt;&lt;br/&gt;&lt;code&gt;IndianAndHipaaPhiMasker&lt;/code&gt;&lt;br/&gt;• Aadhaar, Phone, Clinician De-ID&lt;br/&gt;• ABHA deterministic hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22c55e;fontSize=11;" vertex="1" parent="box-flow1">
          <mxGeometry x="580" y="50" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1-step4" value="&lt;b&gt;4A. Primary S3 Archive&lt;/b&gt;&lt;br/&gt;Writes immutable document:&lt;br/&gt;&lt;code&gt;v1/tenants/TMH-MUMBAI/&lt;br/&gt;patients/PAT-001/.../NOTE.json&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;fontSize=11;" vertex="1" parent="box-flow1">
          <mxGeometry x="870" y="40" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f1-step5" value="&lt;b&gt;4B. Hot Indexing (OpenSearch)&lt;/b&gt;&lt;br/&gt;Indexes searchable summary,&lt;br/&gt;oncology categories, and tokens into&lt;br/&gt;&lt;code&gt;clinical-notes-warm&lt;/code&gt; (&amp;lt; 15ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="box-flow1">
          <mxGeometry x="870" y="130" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f1-step6" value="&lt;b&gt;5. Synchronous 201 Created&lt;/b&gt;&lt;br/&gt;Returns &lt;code&gt;noteId&lt;/code&gt;, &lt;code&gt;tenantId&lt;/code&gt;,&lt;br/&gt;&lt;code&gt;storageUri&lt;/code&gt;, &lt;code&gt;indexedAt&lt;/code&gt;&lt;br/&gt;&lt;i&gt;Guaranteed immediate searchability&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="box-flow1">
          <mxGeometry x="1170" y="50" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Connectors Flow 1 -->
        <mxCell id="c1-1" style="strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="box-flow1" source="f1-step1" target="f1-step2" />
        <mxCell id="c1-2" style="strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="box-flow1" source="f1-step2" target="f1-step3" />
        <mxCell id="c1-3" style="strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="box-flow1" source="f1-step3" target="f1-step4" />
        <mxCell id="c1-4" style="strokeWidth=2;strokeColor=#2563eb;" edge="1" parent="box-flow1" source="f1-step3" target="f1-step5" />
        <mxCell id="c1-5" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="box-flow1" source="f1-step5" target="f1-step6" />

        <!-- FLOW 2: FAST QUERY & RETRIEVAL -->
        <mxCell id="box-flow2" value="FLOW 2: Fast Query &amp;amp; Retrieval from Warm Index (GET /api/v1/patients/{patientId}/notes)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#86efac;fontStyle=1;fontSize=13;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1720" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f2-step1" value="&lt;b&gt;1. Clinician Initiates Search&lt;/b&gt;&lt;br/&gt;GET /api/v1/patients/PAT-001/notes&lt;br/&gt;Headers: &lt;code&gt;X-Tenant-Id: TMH-MUMBAI&lt;/code&gt;&lt;br/&gt;Optional: &lt;code&gt;X-Consent-Artefact-Id&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="box-flow2">
          <mxGeometry x="30" y="50" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2-step2" value="&lt;b&gt;2. Tenant &amp;amp; Consent Resolution&lt;/b&gt;&lt;br/&gt;&lt;code&gt;NotesQueryHandler.resolveTenant()&lt;/code&gt;&lt;br/&gt;• Specific hospital requested? &lt;b&gt;Lock to tenant!&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;tenant=ALL&lt;/code&gt; + consent? &lt;b&gt;Federate!&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="box-flow2">
          <mxGeometry x="320" y="50" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2-step3" value="&lt;b&gt;3. OpenSearch Query&lt;/b&gt;&lt;br/&gt;Single round-trip DSL query on&lt;br/&gt;&lt;code&gt;clinical-notes-warm&lt;/code&gt;&lt;br/&gt;Exact match on tenant + patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="box-flow2">
          <mxGeometry x="630" y="50" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f2-step4" value="&lt;b&gt;4. Check Index Hit Count&lt;/b&gt;&lt;br/&gt;Does index contain notes for&lt;br/&gt;this patient &amp;amp; tenant?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#854d0e;fontSize=11;" vertex="1" parent="box-flow2">
          <mxGeometry x="930" y="40" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f2-step5" value="&lt;b&gt;5. Return Instant Hit (200 OK)&lt;/b&gt;&lt;br/&gt;Payload: Notes array + pagination&lt;br/&gt;&lt;code&gt;servedFrom: INDEX&lt;/code&gt;&lt;br/&gt;Latency: &lt;b&gt;12ms - 18ms&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="box-flow2">
          <mxGeometry x="1230" y="50" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Connectors Flow 2 -->
        <mxCell id="c2-1" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="box-flow2" source="f2-step1" target="f2-step2" />
        <mxCell id="c2-2" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="box-flow2" source="f2-step2" target="f2-step3" />
        <mxCell id="c2-3" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="box-flow2" source="f2-step3" target="f2-step4" />
        <mxCell id="c2-4" value="&lt;b&gt;Yes (Hits &gt; 0)&lt;/b&gt;" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="box-flow2" source="f2-step4" target="f2-step5" />

        <!-- FLOW 3: LAZY S3 REHYDRATION & CACHE MISS -->
        <mxCell id="box-flow3" value="FLOW 3: Cache Miss &amp;amp; Lazy S3 Rehydration (OpenSearch Hits == 0)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;fontStyle=1;fontSize=13;fontColor=#c2410c;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1720" height="220" as="geometry" />
        </mxCell>
        <mxCell id="f3-step1" value="&lt;b&gt;From Flow 2: Hits == 0&lt;/b&gt;&lt;br/&gt;OpenSearch index has no active&lt;br/&gt;entries for patient in this tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="box-flow3">
          <mxGeometry x="30" y="50" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3-step2" value="&lt;b&gt;Fetch All from S3 Partition&lt;/b&gt;&lt;br/&gt;&lt;code&gt;documentStorePort.fetchAllByPatient()&lt;/code&gt;&lt;br/&gt;Scans S3 prefix:&lt;br/&gt;&lt;code&gt;v1/tenants/{tenant}/patients/{pid}/&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;fontSize=11;" vertex="1" parent="box-flow3">
          <mxGeometry x="310" y="50" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3-step3" value="&lt;b&gt;Bulk Index to OpenSearch&lt;/b&gt;&lt;br/&gt;&lt;code&gt;searchIndexPort.bulkIndex(notes)&lt;/code&gt;&lt;br/&gt;Pushes all retrieved historical notes into&lt;br/&gt;&lt;code&gt;clinical-notes-warm&lt;/code&gt; in one batch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="box-flow3">
          <mxGeometry x="640" y="50" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3-step4" value="&lt;b&gt;Serve Rehydrated Notes (200 OK)&lt;/b&gt;&lt;br/&gt;Query repeated against warm index&lt;br/&gt;Returns note summaries with header:&lt;br/&gt;&lt;code&gt;servedFrom: S3_REHYDRATED&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="box-flow3">
          <mxGeometry x="960" y="50" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f3-step5" value="&lt;b&gt;Subsequent Queries Fast&lt;/b&gt;&lt;br/&gt;Future queries for this patient hit the&lt;br/&gt;warm index directly (&amp;lt; 15ms) until evicted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=11;" vertex="1" parent="box-flow3">
          <mxGeometry x="1270" y="50" width="250" height="80" as="geometry" />
        </mxCell>

        <!-- Connectors Flow 3 -->
        <mxCell id="c3-1" style="strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="box-flow3" source="f3-step1" target="f3-step2" />
        <mxCell id="c3-2" style="strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="box-flow3" source="f3-step2" target="f3-step3" />
        <mxCell id="c3-3" style="strokeWidth=2;strokeColor=#ea580c;" edge="1" parent="box-flow3" source="f3-step3" target="f3-step4" />
        <mxCell id="c3-4" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="box-flow3" source="f3-step4" target="f3-step5" />

        <!-- FLOW 4: HOT INDEX EVICTION -->
        <mxCell id="box-flow4" value="FLOW 4: Warm Index Eviction (DELETE /api/v1/patients/{patientId}/index)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;fontStyle=1;fontSize=13;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="1720" height="210" as="geometry" />
        </mxCell>
        <mxCell id="f4-step1" value="&lt;b&gt;1. Evict Request Initiated&lt;/b&gt;&lt;br/&gt;Clinician UI or TTL manager issues&lt;br/&gt;DELETE /api/v1/patients/PAT-001/index" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontSize=11;" vertex="1" parent="box-flow4">
          <mxGeometry x="30" y="50" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f4-step2" value="&lt;b&gt;2. notes-index-handler&lt;/b&gt;&lt;br/&gt;Validates tenant authorization&lt;br/&gt;Builds &lt;code&gt;_delete_by_query&lt;/code&gt; payload" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;fontSize=11;" vertex="1" parent="box-flow4">
          <mxGeometry x="330" y="50" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f4-step3" value="&lt;b&gt;3. OpenSearch Delete by Query&lt;/b&gt;&lt;br/&gt;Removes all patient documents from&lt;br/&gt;warm RAM/disk in &lt;code&gt;clinical-notes-warm&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=11;" vertex="1" parent="box-flow4">
          <mxGeometry x="630" y="50" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f4-step4" value="&lt;b&gt;4. S3 Storage Intact&lt;/b&gt;&lt;br/&gt;Zero data loss. All historical payloads&lt;br/&gt;remain safely in S3 cold storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;fontSize=11;" vertex="1" parent="box-flow4">
          <mxGeometry x="940" y="50" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="f4-step5" value="&lt;b&gt;5. Eviction Confirmation (200 OK)&lt;/b&gt;&lt;br/&gt;Returns &lt;code&gt;deletedFromIndex: N&lt;/code&gt;&lt;br/&gt;&lt;i&gt;Index footprint freed for active patients&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="box-flow4">
          <mxGeometry x="1250" y="50" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- Connectors Flow 4 -->
        <mxCell id="c4-1" style="strokeWidth=2;strokeColor=#9333ea;" edge="1" parent="box-flow4" source="f4-step1" target="f4-step2" />
        <mxCell id="c4-2" style="strokeWidth=2;strokeColor=#9333ea;" edge="1" parent="box-flow4" source="f4-step2" target="f4-step3" />
        <mxCell id="c4-3" style="strokeWidth=2;strokeColor=#9333ea;" edge="1" parent="box-flow4" source="f4-step3" target="f4-step4" />
        <mxCell id="c4-4" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="box-flow4" source="f4-step4" target="f4-step5" />
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <!-- DIAGRAM 3: ABDM CONSENT & CROSS-TENANT PROCESS FLOW                        -->
  <!-- ══════════════════════════════════════════════════════════════════════════ -->
  <diagram id="abdm-process-flow" name="3. ABDM Consent &amp; Federated Process Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="abdm-title" value="Clinical Notes Aggregator — ABDM Tenant-Specific Consent Lifecycle &amp;amp; Cross-Hospital Governance" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- PHASE 1: LOGIN & DEFAULT SEARCH -->
        <mxCell id="p1-box" value="PHASE 1: Clinician Login &amp;amp; Default Patient ID Search (Strict Home Tenant Scoping)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="540" height="960" as="geometry" />
        </mxCell>
        <mxCell id="p1-s1" value="&lt;b&gt;1. Clinician Logs into Workstation&lt;/b&gt;&lt;br/&gt;Active facility established:&lt;br/&gt;&lt;code&gt;currentFacility = TMH-MUMBAI&lt;/code&gt;&lt;br/&gt;Tata Memorial Hospital, Mumbai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=11;" vertex="1" parent="p1-box">
          <mxGeometry x="30" y="50" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1-s2" value="&lt;b&gt;2. Search by Local Patient ID&lt;/b&gt;&lt;br/&gt;Clinician types: &lt;code&gt;PAT-ABDM-001&lt;/code&gt;&lt;br/&gt;in &lt;i&gt;1. Local Patient ID Lookup&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=11;" vertex="1" parent="p1-box">
          <mxGeometry x="30" y="160" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1-s3" value="&lt;b&gt;3. Directory Resolution &amp;amp; ABHA Auto-Population&lt;/b&gt;&lt;br/&gt;System queries ABDM directory:&lt;br/&gt;• Patient identified: &lt;b&gt;Anita Deshmukh (52y / F)&lt;/b&gt;&lt;br/&gt;• Auto-populates box &lt;i&gt;2. ABDM ABHA ID&lt;/i&gt;: &lt;b&gt;14-8765-4321-9876&lt;/b&gt;&lt;br/&gt;• Identifies participating facilities: TMH, Apollo, AIIMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p1-box">
          <mxGeometry x="30" y="260" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1-s4" value="&lt;b&gt;4. Mandatory Scoping to Current Facility&lt;/b&gt;&lt;br/&gt;Dropdown defaults to: &lt;b&gt;TMH-MUMBAI (Home EHR)&lt;/b&gt;&lt;br/&gt;Consent card displays: &lt;code&gt;LOCAL-EHR-TMH&lt;/code&gt; (&lt;font color=&quot;#0284c7&quot;&gt;&lt;b&gt;HOME RECORD&lt;/b&gt;&lt;/font&gt;)&lt;br/&gt;Validity: &lt;i&gt;Permanent (Internal Hospital Record)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p1-box">
          <mxGeometry x="30" y="390" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1-s5" value="&lt;b&gt;5. Query Executed for Current Tenant ONLY&lt;/b&gt;&lt;br/&gt;Header sent: &lt;code&gt;X-Tenant-Id: TMH-MUMBAI&lt;/code&gt;&lt;br/&gt;&lt;i&gt;No federated consent header sent on local query&lt;/i&gt;&lt;br/&gt;Backend returns &lt;b&gt;strictly 2 notes&lt;/b&gt;:&lt;br/&gt;• Operative Note (Modified Radical Mastectomy)&lt;br/&gt;• Histopathology Report (Invasive Ductal Carcinoma)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p1-box">
          <mxGeometry x="30" y="510" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-s6" value="&lt;b&gt;Policy Guarantee: Strict Tenant Isolation&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#16a34a&quot;&gt;&lt;b&gt;PASSED&lt;/b&gt;&lt;/font&gt; · Default search never leaks notes from other hospitals or expired consents. Only current facility notes are visible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="p1-box">
          <mxGeometry x="30" y="650" width="480" height="70" as="geometry" />
        </mxCell>

        <!-- Connectors Phase 1 -->
        <mxCell id="cp1-1" style="strokeWidth=2;strokeColor=#0284c7;" edge="1" parent="p1-box" source="p1-s1" target="p1-s2" />
        <mxCell id="cp1-2" style="strokeWidth=2;strokeColor=#0284c7;" edge="1" parent="p1-box" source="p1-s2" target="p1-s3" />
        <mxCell id="cp1-3" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="p1-box" source="p1-s3" target="p1-s4" />
        <mxCell id="cp1-4" style="strokeWidth=2;strokeColor=#0284c7;" edge="1" parent="p1-box" source="p1-s4" target="p1-s5" />
        <mxCell id="cp1-5" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="p1-box" source="p1-s5" target="p1-s6" />

        <!-- PHASE 2: TENANT-SPECIFIC CONSENT EVALUATION -->
        <mxCell id="p2-box" value="PHASE 2: Clinician Selects Remote Hospital from Dropdown" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;fontStyle=1;fontSize=13;fontColor=#92400e;" vertex="1" parent="1">
          <mxGeometry x="610" y="80" width="560" height="960" as="geometry" />
        </mxCell>
        <mxCell id="p2-s1" value="&lt;b&gt;Clinician Interacts with Hospital Dropdown&lt;/b&gt;&lt;br/&gt;Dropdown options populated dynamically:&lt;br/&gt;• TMH-MUMBAI (Local Home EHR)&lt;br/&gt;• APOLLO-BLR (Live Consent)&lt;br/&gt;• AIIMS-DEL (Expired Consent)&lt;br/&gt;• ALL (Federated View across All Facilities)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p2-box">
          <mxGeometry x="30" y="50" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-s2" value="&lt;b&gt;Consent Verification Engine&lt;/b&gt;&lt;br/&gt;Validates ABDM Consent Artefact:&lt;br/&gt;• Digital signature verified (ABDM Public Key)&lt;br/&gt;• Delivered via &lt;i&gt;ABDM Webhook&lt;/i&gt; or &lt;i&gt;X-Consent-Artefact-Id&lt;/i&gt;&lt;br/&gt;• Verifies &lt;code&gt;validFrom &amp;lt;= now &amp;lt;= validTo&lt;/code&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;fontSize=10;fontColor=#854d0e;" vertex="1" parent="p2-box">
          <mxGeometry x="110" y="170" width="340" height="110" as="geometry" />
        </mxCell>

        <!-- Branch A: LIVE CONSENT -->
        <mxCell id="p2-live-box" value="&lt;b&gt;CASE A: LIVE CONSENT (e.g. APOLLO-BLR)&lt;/b&gt;&lt;br/&gt;• Consent Artefact: &lt;code&gt;CONSENT-ABDM-9901-APOLLO&lt;/code&gt;&lt;br/&gt;• Status Badge: &lt;font color=&quot;#16a34a&quot;&gt;&lt;b&gt;LIVE&lt;/b&gt;&lt;/font&gt; (Valid till 31 Dec 2026)&lt;br/&gt;• Purpose: &lt;i&gt;CARETREAT (Care &amp;amp; Treatment)&lt;/i&gt;&lt;br/&gt;• Query executed with &lt;code&gt;X-Tenant-Id: APOLLO-BLR&lt;/code&gt;&lt;br/&gt;• Returns strictly &lt;b&gt;2 Apollo notes&lt;/b&gt; (Chemo AC-T + Lab CBC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p2-box">
          <mxGeometry x="30" y="320" width="500" height="110" as="geometry" />
        </mxCell>

        <!-- Branch B: EXPIRED CONSENT -->
        <mxCell id="p2-exp-box" value="&lt;b&gt;CASE B: EXPIRED CONSENT (e.g. AIIMS-DEL)&lt;/b&gt;&lt;br/&gt;• Consent Artefact: &lt;code&gt;CONSENT-ABDM-8802-AIIMS&lt;/code&gt;&lt;br/&gt;• Status Badge: &lt;font color=&quot;#dc2626&quot;&gt;&lt;b&gt;EXPIRED&lt;/b&gt;&lt;/font&gt; (Expired on 31 Aug 2026)&lt;br/&gt;• &lt;b&gt;Policy Action:&lt;/b&gt; ACCESS RESTRICTED! HIU prohibited from querying&lt;br/&gt;• &lt;b&gt;Timeline Replaced:&lt;/b&gt; 0 notes shown; Access Restricted Card rendered&lt;br/&gt;• Action provided: &lt;i&gt;&quot;Request Consent Renewal via ABDM PHR&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p2-box">
          <mxGeometry x="30" y="470" width="500" height="120" as="geometry" />
        </mxCell>

        <!-- Interactive Renewal -->
        <mxCell id="p2-renew" value="&lt;b&gt;Simulated Consent Renewal Workflow&lt;/b&gt;&lt;br/&gt;1. Clinician clicks &lt;i&gt;Request Consent Renewal&lt;/i&gt;&lt;br/&gt;2. Patient approves via ABDM PHR App OTP&lt;br/&gt;3. Consent artefact updated to &lt;code&gt;CONSENT-...-RENEWED&lt;/code&gt;&lt;br/&gt;4. Status flips to &lt;font color=&quot;#16a34a&quot;&gt;&lt;b&gt;LIVE&lt;/b&gt;&lt;/font&gt; &amp;amp; AIIMS notes load immediately" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p2-box">
          <mxGeometry x="30" y="630" width="500" height="90" as="geometry" />
        </mxCell>

        <!-- Connectors Phase 2 -->
        <mxCell id="cp2-1" style="strokeWidth=2;strokeColor=#f59e0b;" edge="1" parent="p2-box" source="p2-s1" target="p2-s2" />
        <mxCell id="cp2-2" value="Status == LIVE" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="p2-box" source="p2-s2" target="p2-live-box" />
        <mxCell id="cp2-3" value="Status == EXPIRED" style="strokeWidth=2;strokeColor=#dc2626;" edge="1" parent="p2-box" source="p2-s2" target="p2-exp-box" />
        <mxCell id="cp2-4" style="strokeWidth=2;strokeColor=#2563eb;strokeDasharray=3 3;" edge="1" parent="p2-box" source="p2-exp-box" target="p2-renew" />

        <!-- PHASE 3: FEDERATED "ALL" VIEW WITH EXCLUSION -->
        <mxCell id="p3-box" value="PHASE 3: Federated &quot;ALL&quot; View with Notice &amp;amp; Expired Exclusion" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#f0abfc;fontStyle=1;fontSize=13;fontColor=#86198f;" vertex="1" parent="1">
          <mxGeometry x="1200" y="80" width="560" height="960" as="geometry" />
        </mxCell>
        <mxCell id="p3-s1" value="&lt;b&gt;1. Clinician Selects &quot;ALL&quot;&lt;/b&gt;&lt;br/&gt;Requests unified cross-hospital oncology record for patient" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c026d3;fontSize=11;" vertex="1" parent="p3-box">
          <mxGeometry x="30" y="50" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3-s2" value="&lt;b&gt;2. Multi-Tenant Consent Audit&lt;/b&gt;&lt;br/&gt;System scans consent status across all 3 patient facilities:&lt;br/&gt;• TMH-MUMBAI: &lt;b&gt;HOME RECORD&lt;/b&gt; (Permitted)&lt;br/&gt;• APOLLO-BLR: &lt;b&gt;LIVE CONSENT&lt;/b&gt; (Permitted)&lt;br/&gt;• AIIMS-DEL: &lt;b&gt;EXPIRED CONSENT&lt;/b&gt; (Unauthorized!)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c026d3;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p3-box">
          <mxGeometry x="30" y="150" width="500" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s3" value="&lt;b&gt;3. Display Notice Warning Banner&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot;&gt;&lt;b&gt;⚠️ ABDM Notice: Records from AIIMS-DEL Excluded (Consent Expired)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;i&gt;&quot;Clinical records from AIIMS, New Delhi cannot be displayed because patient consent expired on 31 Aug 2026. Displaying permitted records from TMH-MUMBAI &amp;amp; APOLLO-BLR.&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p3-box">
          <mxGeometry x="30" y="280" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-s4" value="&lt;b&gt;4. Consent Status Card Updates&lt;/b&gt;&lt;br/&gt;• Badge: &lt;font color=&quot;#d97706&quot;&gt;&lt;b&gt;PARTIAL (1 EXPIRED)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;• Artefact: &lt;code&gt;Active: LOCAL-EHR-TMH, CONSENT-ABDM-9901-APOLLO&lt;/code&gt;&lt;br/&gt;• Validity: &lt;i&gt;2 Live / 1 Expired&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p3-box">
          <mxGeometry x="30" y="420" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3-s5" value="&lt;b&gt;5. Filter Excludes Expired Tenant Records&lt;/b&gt;&lt;br/&gt;Backend executes with &lt;code&gt;X-Tenant-Id: ALL&lt;/code&gt;&lt;br/&gt;Governance layer filters out &lt;code&gt;tenantId == AIIMS-DEL&lt;/code&gt;&lt;br/&gt;Displays strictly &lt;b&gt;4 permitted notes&lt;/b&gt; (2 TMH + 2 Apollo)&lt;br/&gt;Timeline filter stats: &lt;b&gt;4 notes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16a34a;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="p3-box">
          <mxGeometry x="30" y="540" width="500" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-s6" value="&lt;b&gt;ABDM Compliance Achieved&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#16a34a&quot;&gt;&lt;b&gt;FULL COMPLIANCE&lt;/b&gt;&lt;/font&gt; · Complete auditability. Clinicians see federated data without violating ABDM expired consent regulations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="p3-box">
          <mxGeometry x="30" y="680" width="500" height="70" as="geometry" />
        </mxCell>

        <!-- Connectors Phase 3 -->
        <mxCell id="cp3-1" style="strokeWidth=2;strokeColor=#c026d3;" edge="1" parent="p3-box" source="p3-s1" target="p3-s2" />
        <mxCell id="cp3-2" style="strokeWidth=2;strokeColor=#c026d3;" edge="1" parent="p3-box" source="p3-s2" target="p3-s3" />
        <mxCell id="cp3-3" style="strokeWidth=2;strokeColor=#d97706;" edge="1" parent="p3-box" source="p3-s3" target="p3-s4" />
        <mxCell id="cp3-4" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="p3-box" source="p3-s4" target="p3-s5" />
        <mxCell id="cp3-5" style="strokeWidth=2;strokeColor=#16a34a;" edge="1" parent="p3-box" source="p3-s5" target="p3-s6" />
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

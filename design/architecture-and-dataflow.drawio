        <!-- EC2 OpenSearch Box -->
        <mxCell id="grp-ec2" value="&lt;b&gt;Dedicated EC2 Instance (t4g.small ARM64 Amazon Linux 2023)&lt;/b&gt;&lt;br/&gt;Elastic IP: &lt;b&gt;13.202.49.76&lt;/b&gt; · Security Group: sg-064789ad79220fbde" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=11;fontColor=#1e40af;" vertex="1" parent="lane-storage">
          <mxGeometry x="30" y="60" width="620" height="360" as="geometry" />
        </mxCell>
        <mxCell id="es-docker" value="&lt;b&gt;OpenSearch 2.15 Cluster (Docker)&lt;/b&gt;&lt;br/&gt;JVM Heap: 1 GB · Port: &lt;b&gt;9200&lt;/b&gt; · Cluster Status: &lt;font color=&quot;#16a34a&quot;&gt;&lt;b&gt;GREEN&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=12;" vertex="1" parent="grp-ec2">
          <mxGeometry x="30" y="40" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="es-index" value="&lt;b&gt;Primary Search Index: clinical-notes-warm&lt;/b&gt;&lt;br/&gt;• 329 Documents across 27 Cancer Patients &amp;amp; 4 Tenants (TMH, APOLLO, AIIMS, MAX)&lt;br/&gt;• BM25 Full-text Analyzers on &lt;i&gt;content.rawText&lt;/i&gt;, &lt;i&gt;summary&lt;/i&gt;, &lt;i&gt;diagnosis&lt;/i&gt;&lt;br/&gt;• Exact Keyword Filters: &lt;i&gt;tenantId&lt;/i&gt;, &lt;i&gt;patientId&lt;/i&gt;, &lt;i&gt;demographics.maskedAbhaId&lt;/i&gt;&lt;br/&gt;• Sharded &amp;amp; Replicated for Fast Query Response (&amp;lt; 15ms latency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;fontColor=#1e293b;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="grp-ec2">
          <mxGeometry x="30" y="130" width="560" height="100" as="geometry" />
        </mxCell>
        <mxCell id="es-nginx" value="&lt;b&gt;Nginx Web Server (:80)&lt;/b&gt;&lt;br/&gt;Serves SPA Frontend (&lt;code&gt;/usr/share/nginx/html/&lt;/code&gt;) with CORS &amp;amp; gzip caching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#334155;fontSize=10;" vertex="1" parent="grp-ec2">
          <mxGeometry x="30" y="250" width="560" height="60" as="geometry" />
        </mxCell>

        <!-- S3 Durable Storage Box -->
        <mxCell id="grp-s3" value="&lt;b&gt;Amazon S3 (Immutable Multi-Tenant Clinical Document Store)&lt;/b&gt;&lt;br/&gt;Bucket: &lt;code&gt;clinical-notes-021891606619-ap-south-1&lt;/code&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;fontSize=11;fontColor=#9d174d;" vertex="1" parent="lane-storage">
          <mxGeometry x="30" y="460" width="620" height="330" as="geometry" />
        </mxCell>
        <mxCell id="s3-structure" value="&lt;b&gt;Patient-Centric Multi-Tenant Prefix Partitioning:&lt;/b&gt;&lt;br/&gt;&lt;code&gt;s3://clinical-notes-.../v1/tenants/{tenantId}/patients/{patientId}/{year}/{month}/{noteId}.json&lt;/code&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Durability:&lt;/b&gt; 99.999999999% (11 9s) SLA with S3 Versioning &amp;amp; KMS Encryption&lt;br/&gt;• &lt;b&gt;Immutability:&lt;/b&gt; WORM compliance; notes cannot be silently overwritten or modified&lt;br/&gt;• &lt;b&gt;Lazy Rehydration Source:&lt;/b&gt; Used to restore OpenSearch index on cold cache miss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#db2777;fontColor=#831843;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="grp-s3">
          <mxGeometry x="30" y="40" width="560" height="120" as="geometry" />
        </mxCell>
        <mxCell id="s3-glacier" value="&lt;b&gt;S3 Glacier Flexible Retrieval / Deep Archive (90+ Days Lifecycle)&lt;/b&gt;&lt;br/&gt;Cost-effective long-term archival for historical oncology records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;" vertex="1" parent="grp-s3">
          <mxGeometry x="30" y="180" width="560" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3-ml" value="&lt;b&gt;Downstream AI/ML Training Dataset Export&lt;/b&gt;&lt;br/&gt;Masked, HIPAA Safe-Harbor de-identified corpus for Clinical LLM &amp;amp; NLP Research" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#f472b6;fontColor=#9d174d;fontSize=10;" vertex="1" parent="grp-s3">
          <mxGeometry x="30" y="250" width="560" height="50" as="geometry" />
        </mxCell>


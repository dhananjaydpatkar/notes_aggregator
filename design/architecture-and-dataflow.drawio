          <mxGeometry x="20" y="590" width="240" height="50" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 3: Serverless Compute Layer (Lambda) -->
        <mxCell id="lane-compute" value="Compute Layer (AWS Lambda — Java 21 GraalVM/SnapStart Ready)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#bbf7d0;fontStyle=1;fontSize=13;fontColor=#166534;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="340" height="960" as="geometry" />
        </mxCell>
        <mxCell id="fn-ingest" value="&lt;b&gt;notes-ingestion-handler&lt;/b&gt;&lt;br/&gt;• IngestionPort (Single &amp;amp; Batch)&lt;br/&gt;• IndianAndHipaaPhiMasker&lt;br/&gt;• Dual write: S3 + OpenSearch&lt;br/&gt;• DynamoDB Idempotency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontSize=11;" vertex="1" parent="lane-compute">
          <mxGeometry x="20" y="160" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fn-query" value="&lt;b&gt;notes-query-handler&lt;/b&gt;&lt;br/&gt;• Tenant Resolution &amp;amp; ABDM Consent&lt;br/&gt;• Single-tenant query vs ALL query&lt;br/&gt;• Warm OpenSearch Query (&amp;lt; 20ms)&lt;br/&gt;• Lazy S3 rehydration on miss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontSize=11;" vertex="1" parent="lane-compute">
          <mxGeometry x="20" y="300" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fn-index" value="&lt;b&gt;notes-index-handler&lt;/b&gt;&lt;br/&gt;• Delete by Patient ID in OpenSearch&lt;br/&gt;• Retains durable S3 storage&lt;br/&gt;• Index eviction lifecycle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontSize=11;" vertex="1" parent="lane-compute">
          <mxGeometry x="20" y="440" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fn-fhir" value="&lt;b&gt;notes-fhir-handler&lt;/b&gt;&lt;br/&gt;• DocumentReference Converter&lt;br/&gt;• CapabilityStatement builder&lt;br/&gt;• LOINC / SNOMED coding mapping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;fontColor=#14532d;fontSize=11;" vertex="1" parent="lane-compute">
          <mxGeometry x="20" y="560" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fn-dynamo" value="&lt;b&gt;DynamoDB: notes-idempotency&lt;/b&gt;&lt;br/&gt;PartitionKey: &lt;code&gt;tenantId#idempotencyKey&lt;/code&gt;&lt;br/&gt;TTL: 24 Hours Anti-Duplication" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fef08a;strokeColor=#ca8a04;fontColor=#854d0e;fontSize=11;" vertex="1" parent="lane-compute">
          <mxGeometry x="50" y="700" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- SWIMLANE 4: Hot Search & Durable Storage -->
